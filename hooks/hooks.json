{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE$CLAUDE_PLUGIN_OPTION_TYPESAFE_API_KEY\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook pre-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE$CLAUDE_PLUGIN_OPTION_TYPESAFE_API_KEY\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook post-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE$CLAUDE_PLUGIN_OPTION_TYPESAFE_API_KEY\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook user-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
