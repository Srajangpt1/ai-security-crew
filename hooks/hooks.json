{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook pre-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook post-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TYPESAFE_API_KEY$ASC_GUARD_ENABLE\" ] || exit 0; uvx --from git+https://github.com/Srajangpt1/ai-security-crew asc-guard hook user-prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$MCP_SECURITY_REVIEW_NO_PREFETCH\" ] || exit 0; (uvx --from git+https://github.com/Srajangpt1/ai-security-crew mcp-security-review fetch-intel --quiet >/dev/null 2>&1 &) ; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
